# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL and keys from your Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # Never expose to client

# ─── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key     # Never expose to client

# ─── Job API (Adzuna) ────────────────────────────────────────────────────────
# Get free credentials at https://developer.adzuna.com/
# If absent, the app falls back to built-in mock data automatically.
JOB_API_ID=your-adzuna-app-id
JOB_API_KEY=your-adzuna-app-key

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Client (copy VITE_ vars to client/.env) ────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
